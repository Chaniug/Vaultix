<?xml version="1.0" encoding="utf-8"?>
<!--
  Credential Provider 能力声明：系统据此把 Vaultix 列为可供应凭据的提供方。
  Android 14+（API 34）起由 Credential Manager 读取；低版本忽略。

  ⚠️⚠️ 能力名字符串**必须逐字符对照官方模板**，前缀不一致会被系统判定为
  「Service does not have the required capabilities」并**静默跳过整个 Provider**
  （现象：设置里显示已启用、credential_service 也有值，但浏览器点密码框毫无反应，
  应用侧连一次 onBeginGetCredentialRequest 都收不到）。这与 manifest action 漏写
  `service.` 段（f474654）是同一族根因——**都是"注册字符串差一点点"**。

  官方模板（developer.android.com/identity/sign-in/credential-provider
  「声明支持的凭据类型」）原文：
      <capability name="android.credentials.TYPE_PASSWORD_CREDENTIAL" />
      <capability name="androidx.credentials.TYPE_PUBLIC_KEY_CREDENTIAL" />
  注意两个前缀**故意不一致**：密码走框架常量、通行密钥走 androidx 常量
  （已用 `grep -a` 核对 credentials-1.3.0 的真实字符串值，与设备 framework.jar 一致）。

  而官方文档另一段（settingsActivity 示例）又把通行密钥写成 `android.credentials.` 前缀——
  文档自相矛盾。故这里**四种拼写全部声明**（能力是超集声明，多写无副作用），
  以抵御框架 / androidx 版本差异导致的再次踩坑。
-->
<credential-provider
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="io.vaultix.vaultix.MainActivity"
    android:settingsSubtitle="@string/setting_credential_provider">
    <capabilities>
        <capability name="android.credentials.TYPE_PASSWORD_CREDENTIAL" />
        <capability name="androidx.credentials.TYPE_PASSWORD_CREDENTIAL" />
        <capability name="androidx.credentials.TYPE_PUBLIC_KEY_CREDENTIAL" />
        <capability name="android.credentials.TYPE_PUBLIC_KEY_CREDENTIAL" />
    </capabilities>
</credential-provider>
