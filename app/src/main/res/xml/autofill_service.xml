<?xml version="1.0" encoding="utf-8"?>
<!--
  Autofill Service 配置（对齐 Bastion / Keyguard）。

  ⚠️ **必须声明 supportsInlineSuggestions="true"**：Android 11+（API 30+）的键盘
  内嵌建议（Gboard / 系统输入法在候选区直接展示密码条目）依赖此属性。此前缺失
  → Edge / Chrome 密码框无内联建议下拉 → 用户看不到填充入口。

  ⚠️ **必须声明 compatibility-package**：Chromium 系浏览器的 web domain 提取
  需要声明兼容性包名。此前缺失 → 系统不把 Vaultix 视为兼容 Edge/Chrome 的
  autofill 提供方 → url_bar 域名不上报 → 匹配全部落空。

  来源：Bastion `app/src/main/res/xml/autofill_service_config.xml`（GPL-3.0，
  Copyright Bastion contributors 2024），按 Vaultix 结构整理。
-->
<autofill-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="io.vaultix.vaultix.MainActivity"
    android:supportsInlineSuggestions="true">

    <!-- Alook -->
    <compatibility-package android:name="alook.browser" android:maxLongVersionCode="@string/version_code_max" />
