<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 的备份 / 设备迁移规则（`.ai/ISSUES.md` #186，2026-10-26）。

  ⚠️ 当前 `AndroidManifest.xml` 里 `android:allowBackup="false"`，本文件**不会**生效。
  保留它是第二道防线（理由同 `backup_rules.xml` 顶部注释）。

  `data-extraction-rules` 把「云备份」与「设备到设备迁移」拆成两段：
  - `cloud-backup`：上传到 Google Drive / 厂商云的那份；
  - `device-transfer`：换机时直连搬迁的那份。
  两段都要排除，**只排除一段等于没排除**（密码管理器最典型的翻车方式：用户换机时
  "门锁信封被搬过去了"，看起来能用，其实解不开）。

  ⚠️ `<exclude>` 的 `path` 语义与 `backup_rules.xml` 一致：
    - `sharedpref` 域名下写**不带 `.xml`** 的偏好文件名；
    - `file` 域名下写相对路径；`path="."` 表示整目录。

  ⚠️ **不要**写 `<exclude domain="cache" ... />`：合法 domain 里没有 `cache`
  （lint `FullBackupContent` 报 **fatal**，会让 `:app:lintVitalFullRelease` 中断发布构建，
  见 `.ai/ISSUES.md` #201）；而 cache 目录本来就不参与备份，写了也是多余的。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="vaultix_secure" />
        <exclude domain="database" path="vaultix.db" />
        <exclude domain="file" path="." />
    </cloud-backup>

    <device-transfer>
        <exclude domain="sharedpref" path="vaultix_secure" />
        <exclude domain="database" path="vaultix.db" />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
