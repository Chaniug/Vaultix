<?xml version="1.0" encoding="utf-8"?>
<!--
  自动填充下拉建议的条目视图（RemoteViews：由系统渲染在填充面板里，
  只能使用 RemoteViews 支持的控件与属性 —— 没有 Compose、没有 Material 组件、
  没有 ripple、没有自定义字体，动态取色也拿不到，面板明暗只能按 uiMode 自己判）。

  ⚠️ RemoteViews 的能力边界（想「更 Material」之前先读这段）：
  - 能做：shape 圆角背景、内边距 / 最小高度、`setTextViewText`、`setTextColor`、
    `setFloat("setTextSize")`、`setInt("setColorFilter")`、
    `setImageViewBitmap`（位图，见 AutofillItemIcon）、`setContentDescription`；
  - 不能做：MaterialCardView 的完整阴影形态、`android:foreground` 水波纹、
    非系统字体族、Material You 动态色。

  ── 2026-09-13 第二轮（用户：「确实紧凑了，但是风格和最新的 material 有点差距」）──
  在 RemoteViews 边界内把规格对齐 **M3 list item**：
  - 行高 **56dp** 且**不设 minHeight 之外的额外垂直内边距**：M3 两行 list item 的
    标准高度就是 56dp（上一版压到 48dp 是「为了紧凑而紧凑」，反而偏离了 M3 的节奏）；
    两行文字用 4dp 内边距自己撑开，行高交给容器保证 —— 得到的是一致的心跳感。
  - 图标 **24dp 位图落在 40dp 圆形 tonal 容器**上（M3 list item 的 icon container 规格）：
    站点图标与字母头像于是拥有完全相同的尺寸与形状，整列的视觉重量整齐；
    容器色按 uiMode 取 `surfaceContainerHighest` 等效值（见 drawable(-night)/autofill_item_icon_bg）。
  - 图标容器与文字间距 **16dp**（M3 list item 的 `leading → label` 间距）。
  - 水平内边距 **16dp**（与 Vaultix 列表卡片、M3 list item 一致）。
  - 标题 16sp / 副标题 14sp（M3 `bodyLarge` / `bodyMedium`），层次由**字号 + 色阶**给出，
    不靠加粗；标题用 `sans-serif-medium` 仅作轻微强调。
  - 副标题单行省略 + 标题单行省略：面板宽度有限，宁可截断也不要换行把行撑高。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/autofill_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- 图标：40dp 圆形容器 + 24dp 居中位图（M3 list item 的 icon container 规格）。 -->
    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/autofill_item_icon_bg">

        <ImageView
            android:id="@+id/autofill_item_icon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/autofill_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/autofill_item_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
