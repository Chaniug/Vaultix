<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Compose 应用的基础主题：仅要求无 ActionBar，具体配色由 Compose Material3 提供 -->
    <style name="Theme.Vaultix" parent="android:Theme.Material.Light.NoActionBar">
        <!--
          冷启动窗口底色（Compose 首帧之前可见的那一帧）。

          ⚠️ 不设它 = 用 `Theme.Material.Light` 的默认白 ⇒ 深色模式下冷启动闪白
          （2026-11-09 23:33 用户截图）。按 values / values-night 分开取回退色板的
          surface，见两个 colors.xml 里的说明。

          ⚠️ 这个主题是**恒浅色**的平台主题（不是 DayNight），所以只能靠
          `values-night/colors.xml` 覆盖颜色值，不能指望主题自己翻转。
        -->
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- 自动填充认证回灌用：窗口透明（背景由 Compose 自己画遮罩），不做转场动画 -->
    <style name="Theme.Vaultix.Transparent" parent="Theme.Vaultix">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
