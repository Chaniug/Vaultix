<?xml version="1.0" encoding="utf-8"?>
<!--
  自动填充下拉里**单行的外框**（12dp 圆角 + 极低透明度实底，无描边）。

  为什么从「描边」改成「实底」（2026-09-13）：描边在系统面板里看起来像一张生硬的表格，
  而 Material3 的 list item 本来就是「比背景略亮/略暗一档的面」，没有边框。
  实底用**低 alpha**（见 values / values-night 的 autofill_item_surface）实现 ——
  它不是「猜一个面板底色」，而是把面板底色压暗/提亮一档，任何 ROM 面板上都成立。

  圆角量级对齐 App 内条目卡片（`EntryCard`，12dp）。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="12dp" />
    <solid android:color="@color/autofill_item_surface" />
</shape>

