<?xml version="1.0" encoding="utf-8"?>
<!--
  Vaultix 应用图标 · 单色层（自适应图标的 `monochrome`，Android 13+ 主题图标）

  它是什么
  ────────────────────────────────────────────────────────────────────────
  开启「主题图标」后，系统**丢掉背景与配色**，只取这一层的**形状（alpha）**，
  再用从壁纸派生的单色重新着色 ⇒ 所以这里只能是**单一纯色剪影**，任何渐变/多色都会被压平。

  与彩色前景的差异（有意为之，但形状语义必须一致）
  ────────────────────────────────────────────────────────────────────────
  外圈：彩色版是白描边盾；本层同样是描边（同色 ⇒ 靠"缝"与内场区分）。
  内场：彩色版白色实心；本层相同。
  **V 带：彩色版是金色填色；本层必须改成挖空（洞）。**
  为什么 V 要改洞：单色层只有一种着色，**填色的 V 会与盾同色而整块消失**；
  挖空后 V 会透出系统给主题图标的背景色，形状依然可辨。
  ⇒ 两层结构可以不同，但**形状语义必须一致**（都是"盾 + V"），否则普通图标与主题图标会错位。

  ⚠️ 填充色用白色只是"给个纯色"，实际渲染由系统着色覆盖；换黑也一样。
  ⚠️ 本注释里不能出现连续两个短横线（XML 注释的硬限制，写表格分隔线会直接让解析失败）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 描边盾（与彩色前景同一几何） -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M40,31 L68,31 Q74,31 74,38 L74,56 C74,69 66,78 54,84 C42,78 34,69 34,56 L34,38 Q34,31 40,31 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.2" />
    <!-- 内场 + V 挖空（V 与彩色前景同一几何：质心已对齐 y=54.73） -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M43.08,36.72 L64.92,36.72 Q69.60,36.72 69.60,42.18 L69.60,56.22 C69.60,66.36 63.36,73.38 54.00,78.06 C44.64,73.38 38.40,66.36 38.40,56.22 L38.40,42.18 Q38.40,36.72 43.08,36.72 Z M43,45 L49,45 L54,63 L59,45 L65,45 L54,71 Z" />
</vector>
