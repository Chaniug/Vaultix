<?xml version="1.0" encoding="utf-8"?>
<!--
  Vaultix 应用图标 · 背景层（自适应图标的 `background`）

  ── 为什么是"满幅矩形 + 渐变" ──────────────────────────────────────────────
  自适应图标的背景层会被系统当作**无限延伸的底板**：不同 OEM 的遮罩（圆 / 方 /
  圆角方 / squircle / 水滴…）只决定**裁哪儿**，而背景必须保证"裁到哪儿都有颜色"。
  所以背景一律画满 108×108、不做任何内缩 —— 缩了就可能在某些遮罩下露出白边。

  ── 颜色 ────────────────────────────────────────────────────────────────
  三档**对角**渐变（左上亮 → 中 → 右下深），给纯色底以纵深；小尺寸下也不会显脏。
  `angle=315` = 左上 → 右下（shape 渐变角度制：0 向右、90 向上、270 向下）。
  ⚠️ 三档要用 `centerColor`，只给 start/end 会退化成两档、丢掉中间过渡。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:centerColor="@color/ic_launcher_bg_mid"
        android:endColor="@color/ic_launcher_bg_bottom"
        android:startColor="@color/ic_launcher_bg_top"
        android:type="linear" />
</shape>
