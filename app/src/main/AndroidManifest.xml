<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 相机：仅用于扫描 TOTP 的 otpauth:// 二维码（不拍照、不上传、不落盘） -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 通知：快速填充的「复制用户名」接力通知（Android 13+ 需运行时授权） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 验证码通知：填充后在通知栏实时显示 2FA 码，需前台服务承载（每秒刷新 + 倒计时）。
         API 34+ 起 specialUse 类型必须同时声明 FOREGROUND_SERVICE_SPECIAL_USE。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- CameraX 需要设备有后置摄像头（自动对焦可选） -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Android 11（API 30）起的包可见性：不声明就查不到完整应用列表
         （「关联应用」只能看到少数几个 App）。只声明 LAUNCHER intent，
         不申请 QUERY_ALL_PACKAGES（应用商店审核风险）。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".VaultixApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vaultix"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Vaultix">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 自动填充的认证回灌宿主：由系统经 PendingIntent 拉起，需 exported。
             透明主题 + 无历史栈：用完即走，不进入最近任务。
             ⚠️ launchMode 用 standard、不设 NEW_TASK（认证型意图）：dataset 认证（主密码
             二次验证 / 填充后复制验证码）必须由系统以「可收回 EXTRA_AUTHENTICATION_RESULT」
             的方式启动——singleTask 复用实例走 onNewIntent、NEW_TASK 推进独立 task 都会丢
             认证结果（表现为「验证码复制成功但密码没填进」）。
             ⚠️ taskAffinity 必须独立于默认（包名）：否则引导型（NEW_TASK）PendingIntent 会把
             后台含 MainActivity 的 task 拉到前台——认证 Activity 无感 finish 后露出主界面，
             表现为「Via 点密码条目闪回 Vaultix」（autoCopyTotp 开启时必现）。 -->
        <activity
            android:name=".autofill.AutofillActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity="io.vaultix.vaultix.autofill"
            android:theme="@style/Theme.Vaultix.Transparent" />

        <!-- 系统自动填充服务（M2-a）：密码填充走 AutofillService（API 26+）。
             系统通过 BIND_AUTOFILL_SERVICE 权限绑定本服务；settingsActivity 指向
             MainActivity（承载设置导航）。行为在后续里程碑（M2-a.2~a.6）逐步接入。 -->
        <service
            android:name=".autofill.VaultixAutofillService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <!-- 必须是 AutofillService.SERVICE_INTERFACE，否则系统「自动填充服务」列表扫不到本应用 -->
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>

        <!-- Credential Provider（M3 最高优先）：Android 14+ 起 Edge / Chrome 优先走 Credential
             Manager 取凭据；不注册此服务 → 系统根本不会向 Vaultix 询问 passkey，表现为「网站登录时
             通行密钥不出现」。注册后即被系统识别，并同时供应 public-key（通行密钥）+ password（密码）。
             注意：启用后 Credential Manager 会接管「登录字段」自动填充，本服务必须同时声明 password
             能力，否则密码框为空、传统 AutofillService 在凭据字段上被绕过（见 credential_provider.xml）。 -->
        <service
            android:name=".passkey.VaultixCredentialProviderService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <!-- ⚠️ action 必须是 android.service.credentials.CredentialProviderService：
                 曾误写为 android.credentials.CredentialProviderService（漏 service. 段），
                 导致系统无法发现本 Provider——系统设置里没有启用项、Chrome/Edge 永远不弹、
                 passkey 查不到（credential_service 恒空）。此 bug 为 Credential Provider
                 集成「始终无法启用」的总根因。 -->
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/credential_provider" />
        </service>

        <!-- 通行密钥「查询 / 创建」宿主：由 Credential Provider 的候选 PendingIntent 拉起，
             透明卡片确认 + 设备验证后回灌 assertion / attestation（见 VaultixCredentialProviderService）。 -->
        <activity
            android:name=".passkey.PasskeyGetActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.Vaultix.Transparent" />
        <activity
            android:name=".passkey.PasskeyCreateActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.Vaultix.Transparent" />
        <!-- 密码「填充」宿主：由 Credential Provider 的 GET(password) 候选 PendingIntent 拉起，
             透明卡片确认后把解密明文 (用户名, 密码) 回灌 Credential Manager（见 PasswordGetActivity）。 -->
        <activity
            android:name=".passkey.PasswordGetActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.Vaultix.Transparent" />

        <!-- Quick Settings「快速填充」磁贴：不依赖输入法内联建议、不依赖无障碍服务，
             点一下进条目搜索 → 复制密码（通知栏可接力复制用户名）→ 回到原 App 粘贴。
             ACTIVE_TILE 让磁贴在未被使用时也保持可交互（否则部分 ROM 上会显示「未激活」）。 -->
        <service
            android:name=".autofill.shortcut.AutofillTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_lock"
            android:label="@string/tile_manual_fill"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- 自动填充保存确认：框架经 onSaveRequest 回调后由本应用自己拉起（同应用内部） -->
        <activity
            android:name=".autofill.save.AutofillSaveActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Vaultix.Transparent" />

        <!-- 内联建议占位 Activity（Bastion 同款 15 行 no-op）：Credential/Autofill 内联
             建议的宿主占位；本应用实际回灌走 AutofillActivity + 系统 sheet，这里仅占位以满足
             框架对 inline 宿主的声明（next-steps 批次④）。 -->
        <activity
            android:name=".autofill.AutofillInlinePlaceholderActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.Vaultix.Transparent" />

        <!-- 验证码通知（对齐 Bastion AutofillOtpNotificationService）：填充后若页面没有
             验证码框，用通知栏实时承载验证码（每秒刷新 + 倒计时 + 点按复制最新码），
             避免「第一步登录就盲复制验证码」的多余动作。仅本应用启动，不导出。
             ⚠️ specialUse 前台服务必须附带 PROFILE 用途说明，否则 Play 审核与部分 ROM 会拒。 -->
        <service
            android:name=".autofill.otp.OtpNotificationService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows the current two-factor code during autofill" />
        </service>

        <!-- 快速填充界面：由磁贴拉起（同应用内部，无需 exported） -->
        <activity
            android:name=".autofill.shortcut.ManualFillActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Vaultix" />

        <!-- 接力复制用户名（通知动作，仅本应用可触发） -->
        <receiver
            android:name=".autofill.shortcut.SmartCopyReceiver"
            android:exported="false" />
    </application>

</manifest>
