<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 相机：仅用于扫描 TOTP 的 otpauth:// 二维码（不拍照、不上传、不落盘） -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 通知：快速填充的「复制用户名」接力通知（Android 13+ 需运行时授权） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- CameraX 需要设备有后置摄像头（自动对焦可选） -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Android 11（API 30）起的包可见性：不声明就查不到完整应用列表
         （「关联应用」只能看到少数几个 App）。只声明 LAUNCHER intent，
         不申请 QUERY_ALL_PACKAGES（应用商店审核风险）。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- ⚠️⚠️ android:enableOnBackInvokedCallback="false" —— 2026-09-13 第五轮才定案，别改回 true。
         【现象】用户报告：**手势返回**时能看到"当前页缩小约 80% 并居中、下层页面露出来"的 1~2 帧；
         条目详情 / 卡包 / 设置子页**处处都有**，而返回键 / `adb input keyevent 4` **完全没有**。
         【机制】那就是 **Android 的预测式返回（predictive back）预览**：手势期间系统把当前
         页面缩小、把下层页面露出来，松手后再播完动画。
         【为什么之前一直是开着的】该属性对 **targetSdk 36+ 的应用默认值为 true**：
         ① 不声明 ⇒ 预测式返回**已启用** ⇒ 有预览（用户最初看到的就是它）；
         ② 显式写 true ⇒ **等于把预览钉死开启**（我第 4 轮就是这么改的，所以"依然存在"）；
         ③ 显式写 false ⇒ **关掉预览**，手势返回交回 App，只播我们自己的转场
         （`VaultixApp` 的 NavHost：纯横向位移、无缩放）。
         【与其它改动的关系】`NavHost(sizeTransform = null)`、Tab 容器尺寸补间零时长、
         「跳过重放 Tab 过渡」都是**顺手修掉的真问题**，但它们都不是这个现象的主因 ——
         主因就是这里的预览。别把它们回退。
         【若要保留预测式手感】改成 true 并配合 `PredictiveBackHandler` **自绘**预览
         （我们的转场是纯位移，自绘后就不会有缩放）。 -->
    <application
        android:name=".VaultixApplication"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vaultix"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Vaultix">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 自动填充的认证回灌宿主：由系统经 PendingIntent 拉起，需 exported。
             透明主题 + 无历史栈：用完即走，不进入最近任务。
             ⚠️ launchMode 用 standard、不设 NEW_TASK（认证型意图）：dataset 认证（主密码
             二次验证 / 填充后复制验证码）必须由系统以「可收回 EXTRA_AUTHENTICATION_RESULT」
             的方式启动——singleTask 复用实例走 onNewIntent、NEW_TASK 推进独立 task 都会丢
             认证结果（表现为「验证码复制成功但密码没填进」）。
             ⚠️⚠️ **`taskAffinity` 也必须与包名一致（即：不要声明它）** —— 2026-09-13 定案。
             这里曾经声明 `taskAffinity="io.vaultix.vaultix.autofill"`，理由是「引导型 NEW_TASK
             PendingIntent 会把含 MainActivity 的 task 拉到前台、认证 Activity 无感 finish 后
             露出主界面」。但**那个问题的真正来源就是认证意图上的 NEW_TASK**（已删），
             而独立 taskAffinity 造成的是**同一个致命后果**：Activity 永远活在另一个 task ⇒
             `setResult(RESULT_OK, EXTRA_AUTHENTICATION_RESULT)` 送不回系统 ⇒
             系统日志报 `onAuthenticationResult(): empty intent` ⇒ 回灌的候选被整个丢弃 ⇒
             用户现象「在登录界面反复解锁、永远看不到密码条目」。

             ⚠️⚠️ **`noHistory` 同样不能声明** —— 2026-09-14 定案（`.ai/ISSUES.md` #90）。
             这里曾经写 `android:noHistory="true"`，理由是「对照 Bitwarden 的认证 Activity
             声明（exported + noHistory + 透明主题）」。但那是**照抄配置、却承袭了不同的
             架构**：Bitwarden 走 NEW_TASK + 独立进程回灌，而本项目的回灌依赖
             「本 Activity **留在栈上**，用户解锁返回后由 `onResume` 投递
             `EXTRA_AUTHENTICATION_RESULT`」（见 AutofillActivity 类注释「解锁即回填」，
             以及 `openVaultAndFinish()` 里**故意不 finish** 的那段）。
             `noHistory` 的语义正是「一旦不可见即销毁并 finish」，与「留在栈上」物理互斥
             ⇒ 用户解锁返回时 `onResume` 永不触发 ⇒ **没有任何人能投递认证结果** ⇒
             用户现象「指纹解锁成功了，但密码条目永远填不进去」。
             对照 Bitwarden（同形态项目）的认证 Activity 声明：`exported` + `launchMode=singleTop`
             + 透明主题，**没有 taskAffinity、没有 excludeFromRecents**。 -->
        <activity
            android:name=".autofill.AutofillActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.Vaultix.Transparent" />

        <!-- 系统自动填充服务（M2-a）：密码填充走 AutofillService（API 26+）。
             系统通过 BIND_AUTOFILL_SERVICE 权限绑定本服务；settingsActivity 指向
             MainActivity（承载设置导航）。行为在后续里程碑（M2-a.2~a.6）逐步接入。 -->
        <service
            android:name=".autofill.VaultixAutofillService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <!-- 必须是 AutofillService.SERVICE_INTERFACE，否则系统「自动填充服务」列表扫不到本应用 -->
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>

        <!-- Credential Provider（M3 最高优先）：Android 14+ 起 Edge / Chrome 优先走 Credential
             Manager 取凭据；不注册此服务 → 系统根本不会向 Vaultix 询问 passkey，表现为「网站登录时
             通行密钥不出现」。注册后即被系统识别，并同时供应 public-key（通行密钥）+ password（密码）。
             注意：启用后 Credential Manager 会接管「登录字段」自动填充，本服务必须同时声明 password
             能力，否则密码框为空、传统 AutofillService 在凭据字段上被绕过（见 credential_provider.xml）。 -->
        <service
            android:name=".passkey.VaultixCredentialProviderService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <!-- ⚠️ action 必须是 android.service.credentials.CredentialProviderService：
                 曾误写为 android.credentials.CredentialProviderService（漏 service. 段），
                 导致系统无法发现本 Provider——系统设置里没有启用项、Chrome/Edge 永远不弹、
                 passkey 查不到（credential_service 恒空）。此 bug 为 Credential Provider
                 集成「始终无法启用」的总根因。 -->
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/credential_provider" />
        </service>

        <!-- Credential Provider 的**透明中转 Activity**（trampoline）。
             候选点击的 PendingIntent 指向这里；它不渲染任何界面，只把请求交接给主界面
             并把结果原样透传回 Credential Manager。
             必须 exported=false：只允许本 App / 系统经 PendingIntent 授权拉起，
             外部 App 无法借此注入请求（对齐 Bitwarden 的 CredentialProviderActivity）。 -->
        <activity
            android:name=".passkey.CredentialProviderActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@style/Theme.Vaultix.Transparent" />
        <!-- 通行密钥「查询 / 创建」宿主：由 Credential Provider 的候选 PendingIntent 拉起，
             透明卡片确认 + 设备验证后回灌 assertion / attestation（见 VaultixCredentialProviderService）。 -->
        <activity
            android:name=".passkey.PasskeyGetActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.Vaultix.Transparent" />
        <activity
            android:name=".passkey.PasskeyCreateActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.Vaultix.Transparent" />
        <!-- 密码「填充」宿主：由 Credential Provider 的 GET(password) 候选 PendingIntent 拉起，
             透明卡片确认后把解密明文 (用户名, 密码) 回灌 Credential Manager（见 PasswordGetActivity）。 -->
        <activity
            android:name=".passkey.PasswordGetActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.Vaultix.Transparent" />
        <!-- Credential Provider 的「设置」入口宿主（provider.xml settingsActivity 指向此处）。
             系统凭据管理器「密码和账号 → Vaultix → 齿轮」会拉起它。必须是 exported
             （系统设置应用要能跨进程启动），且用普通主题（是真正的设置页，非透明中转）。 -->
        <activity
            android:name=".passkey.CredentialProviderSettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop" />

        <!-- Quick Settings「快速填充」磁贴：不依赖输入法内联建议、不依赖无障碍服务，
             点一下进条目搜索 → 复制密码（通知栏可接力复制用户名）→ 回到原 App 粘贴。
             ACTIVE_TILE 让磁贴在未被使用时也保持可交互（否则部分 ROM 上会显示「未激活」）。 -->
        <service
            android:name=".autofill.shortcut.AutofillTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_lock"
            android:label="@string/tile_manual_fill"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- 自动填充保存确认：框架经 onSaveRequest 回调后由本应用自己拉起（同应用内部） -->
        <activity
            android:name=".autofill.save.AutofillSaveActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Vaultix.Transparent" />

        <!-- 内联建议占位 Activity（Bastion 同款 15 行 no-op）：Credential/Autofill 内联
             建议的宿主占位；本应用实际回灌走 AutofillActivity + 系统 sheet，这里仅占位以满足
             框架对 inline 宿主的声明（next-steps 批次④）。 -->
        <activity
            android:name=".autofill.AutofillInlinePlaceholderActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.Vaultix.Transparent" />

        <!-- 快速填充界面：由磁贴拉起（同应用内部，无需 exported） -->
        <activity
            android:name=".autofill.shortcut.ManualFillActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Vaultix" />

        <!-- 接力复制用户名（通知动作，仅本应用可触发） -->
        <receiver
            android:name=".autofill.shortcut.SmartCopyReceiver"
            android:exported="false" />

        <!-- OneDrive（MSAL）授权回调宿主。
             由 MSAL 自己拉起：用户在系统浏览器/Custom Tab 里登录后，
             Microsoft 会把授权码重定向到 `msauth://io.vaultix.vaultix/<签名哈希>`，
             这个 Activity 负责接住回调并交还 SDK。

             ⚠️ 这里的 host 必须等于 applicationId，path 的 `/<哈希>` 必须是
             **签名证书 SHA-1 的 base64**（标准 base64，含 + / =，不是 URL 编码值）。
             哈希与 Azure 门户里登记的「签名哈希」框**同源**，改动签名即失效。
             ⚠️ 只测「本地出包 + 重签」的包（见 .ai/conventions/8.7-环境.md）：
             直接用 debug 签名安装时证书不同、哈希不同，回调会失败。 -->
        <activity
            android:name="com.microsoft.identity.client.BrowserTabActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="msauth"
                    android:host="io.vaultix.vaultix"
                    android:path="/s8Z1PBw9xUHOxihJdrGizMzPhb0=" />
            </intent-filter>
        </activity>

        <!--
          开发者模式「导出日志」的分享出口（2026-09-21 新增）。
          ⚠️ authority 必须与代码里的 `"${packageName}.fileprovider"` 一致，否则 getUriForFile 抛
            IllegalArgumentException（"Failed to find configured root"）。
          ⚠️ grantUriPermissions 必须为 true，否则 ACTION_SEND 拿到了 URI 也读不到文件。
          ⚠️ 暴露范围由 res/xml/file_paths.xml 白名单限定（只给 cacheDir/dev_logs）。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
